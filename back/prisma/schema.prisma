generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFESSOR
  ALUNO
}

model Curso {
  idCurso      Int      @id @default(autoincrement()) @map("id_curso")
  nomeCurso    String   @db.VarChar(100) @map("nome_curso")
  descricao    String?  @db.Text
  cargaHoraria Int      @map("carga_horaria")
  turmas       Turma[]

  @@map("cursos")
}

model Professor {
  idProfessor  Int      @id @default(autoincrement()) @map("id_professor")
  nome         String   @db.VarChar(100)
  especialidade String?  @db.VarChar(100)
  email        String?   @unique @db.VarChar(100)
  telefone     String?   @db.VarChar(20)
  turmas       Turma[]

  @@map("professores")
}

model Turma {
  idTurma      Int      @id @default(autoincrement()) @map("id_turma")
  nomeTurma    String   @db.VarChar(50) @map("nome_turma")
  ano          Int
  idCurso      Int?     @map("id_curso")
  idProfessor  Int?     @map("id_professor")
  curso        Curso?   @relation(fields: [idCurso], references: [idCurso], onUpdate: Cascade, onDelete: Restrict)
  professor    Professor? @relation(fields: [idProfessor], references: [idProfessor], onUpdate: Cascade, onDelete: SetNull)
  alunos       Aluno[]

  @@index([idCurso])
  @@index([idProfessor])
  @@map("turmas")
}

model Aluno {
  idAluno        Int      @id @default(autoincrement()) @map("id_aluno")
  nome           String   @db.VarChar(100)
  dataNascimento DateTime? @map("data_nascimento")
  email          String?  @unique @db.VarChar(100)
  telefone       String?  @db.VarChar(20)
  idTurma        Int?     @map("id_turma")
  turma          Turma?   @relation(fields: [idTurma], references: [idTurma], onUpdate: Cascade, onDelete: SetNull)

  @@index([idTurma])
  @@map("alunos")
}

model Usuario {
  idUsuario   Int      @id @default(autoincrement()) @map("id_usuario")
  nome        String   @db.VarChar(100)
  email       String   @unique @db.VarChar(100)
  senhaHash   String   @map("senha_hash") @db.VarChar(255)
  papel       Role     @default(ADMIN)
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("usuarios")
}